{
  "name": "@excalibur/app",
  "private": true,
  "version": "0.1.0",
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "build:dist": "electron-builder --win",
    "dev": "cross-env NODE_ENV=development electron .",
    "test": "vitest run"
  },
  "dependencies": {
    "@excalibur/ipc": "workspace:*",
    "@excalibur/plugin-sdk": "workspace:*",
    "@excalibur/shared": "workspace:*",
    "electron": "^28.0.0",
    "fs-extra": "^11.3.3",
"zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.excalibur.app",
    "productName": "Excalibur",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "!dist-build"
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Excalibur"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
